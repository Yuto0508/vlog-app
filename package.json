{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "predev": "node -e \"try{require('fs').unlinkSync('public/hot')}catch(e){}\"",
        "dev": "vite",
        "format": "prettier --write \"resources/**/*.{js,css,blade.php}\"",
        "format:check": "prettier --check \"resources/**/*.{js,css,blade.php}\""
    },
    "devDependencies": {
        "@shufo/prettier-plugin-blade": "^1.16.2",
        "@tailwindcss/forms": "^0.5.2",
        "@tailwindcss/vite": "^4.0.0",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.2",
        "concurrently": "^9.0.1",
        "laravel-vite-plugin": "^3.1",
        "postcss": "^8.4.31",
        "prettier": "^3.9.6",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "tailwindcss": "^3.1.0",
        "vite": "^8.0.0"
    }
}

# 本番環境用の .env の雛形。サーバー上で .env にコピーして値を埋める。
#   cp .env.production.example .env
#   php artisan key:generate
# 実際の .env や秘密の値は Git にコミットしないこと。

APP_NAME=Vlog
APP_ENV=production
APP_KEY=
# 本番では必ず false（true だとエラー画面にスタックトレースや設定値が出る）
APP_DEBUG=false
# 公開する URL。必ず https:// で始める
APP_URL=https://example.com

APP_LOCALE=ja
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ja_JP

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# SQLite を使う場合、database/database.sqlite を消えない場所に置くこと
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=vlog
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# セッションの中身を暗号化する（G2）。切り替え時は全員が一度ログアウトされる
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS でのみ Cookie を送る（G3）
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
# 画像は public ディスクに保存する。デプロイ後に php artisan storage:link を実行すること
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# パスワードリセットのメールを送るには、log ではなく実際の SMTP を設定する
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
